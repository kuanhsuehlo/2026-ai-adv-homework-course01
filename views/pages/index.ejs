<div id="app">
  <!-- Hero -->
  <section class="relative h-[560px] lg:h-[700px] overflow-hidden bg-forest">
    <img
      src="https://images.unsplash.com/photo-1457089328109-e5d9bd499191?w=1600&q=80"
      alt="花卉"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/20 to-black/70"></div>

    <div class="relative h-full flex flex-col items-center justify-center gap-5 lg:gap-7 px-6 text-center">
      <p class="font-caption text-[11px] lg:text-xs font-medium tracking-[0.5em] text-rose-light">
        SEASONAL BOTANICAL ATELIER — TAIPEI
      </p>
      <h1 class="font-display font-light text-5xl md:text-7xl lg:text-[8.5rem] tracking-[0.15em] lg:tracking-[0.18em] text-cream leading-none">
        FLORISTE
      </h1>
      <div class="flex items-center gap-5">
        <span class="hidden sm:block w-14 h-px bg-rose-primary"></span>
        <p class="font-serif-tc font-light text-lg lg:text-[22px] tracking-[0.4em] text-cream">花開有時，為你而綻</p>
        <span class="hidden sm:block w-14 h-px bg-rose-primary"></span>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-4 mt-4">
        <a href="/shop" class="bg-rose-primary text-white text-sm font-medium tracking-[0.3em] px-11 py-4 rounded hover:bg-rose-dark transition-colors">
          探索花卉
        </a>
        <a href="#subscribe" class="border border-cream/50 text-cream text-sm tracking-[0.3em] px-11 py-4 rounded hover:bg-cream/10 transition-colors">
          訂閱花禮
        </a>
      </div>
    </div>

    <div class="absolute bottom-0 inset-x-0 hidden md:flex items-center justify-between px-16 pb-6">
      <span class="font-caption text-[11px] tracking-[0.25em] text-cream/70">EST. 2026 — TAIWAN</span>
      <span class="font-caption text-[11px] tracking-[0.25em] text-cream/70">&darr; SCROLL</span>
      <span class="font-caption text-[11px] tracking-[0.25em] text-cream/70">FRESH &middot; SEASONAL &middot; HANDCRAFTED</span>
    </div>
  </section>

  <!-- Category Strip -->
  <section class="border-b border-hairline bg-cream overflow-x-auto">
    <div class="flex items-center justify-start lg:justify-center h-14 px-6 whitespace-nowrap">
      <template v-for="(cat, i) in ['玫瑰', '鬱金香', '芍藥', '繡球', '向日葵', '乾燥花', '客製花禮']" :key="cat">
        <span v-if="i > 0" class="w-px h-4 bg-hairline shrink-0"></span>
        <a href="/shop" class="px-7 text-xs tracking-[0.35em] text-text-secondary hover:text-rose-primary transition-colors shrink-0">{{ cat }}</a>
      </template>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="max-w-[1440px] mx-auto px-6 lg:px-16 py-16 lg:py-24">
    <div class="flex items-end justify-between mb-12">
      <div class="flex flex-col gap-3">
        <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-primary">№ 01 — FEATURED COLLECTION</p>
        <h2 class="font-serif-tc text-3xl lg:text-[46px] text-text-primary">本週精選花藝</h2>
      </div>
      <a href="/shop" class="hidden sm:flex items-center gap-3 pb-2 text-[13px] tracking-[0.25em] text-text-primary hover:text-rose-primary transition-colors group">
        查看全部
        <span class="w-10 h-px bg-text-primary group-hover:bg-rose-primary transition-colors"></span>
      </a>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="w-8 h-8 border-2 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
    </div>

    <div v-else-if="products.length === 0" class="text-center py-16">
      <p class="font-display text-2xl text-rose-primary mb-3">&#10048;</p>
      <p class="text-text-secondary">目前沒有商品，請稍後再來看看</p>
    </div>

    <div v-else class="grid lg:grid-cols-2 gap-7">
      <!-- Large card -->
      <div v-if="products[0]" class="cursor-pointer group" @click="goToProduct(products[0].id)">
        <div class="relative overflow-hidden h-[360px] lg:h-[560px]">
          <img
            :src="products[0].image_url || fallbackImage"
            :alt="products[0].name"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <span class="absolute top-6 left-6 bg-forest text-cream font-caption text-[11px] font-medium tracking-[0.25em] px-[18px] py-2">
            BESTSELLER
          </span>
        </div>
        <div class="flex items-start justify-between pt-6 gap-4">
          <div class="flex flex-col gap-2 min-w-0">
            <p class="font-caption text-[11px] tracking-[0.35em] text-rose-primary">SIGNATURE — 招牌花藝</p>
            <h3 class="font-serif-tc text-xl lg:text-[26px] text-text-primary">{{ products[0].name }}</h3>
            <p class="text-[13px] font-light leading-relaxed text-text-secondary line-clamp-2">{{ products[0].description }}</p>
            <button
              @click.stop="addToCart(products[0])"
              :disabled="products[0]._adding || products[0].stock <= 0"
              class="self-start mt-1 text-xs tracking-[0.2em] text-text-secondary underline underline-offset-4 hover:text-rose-primary transition-colors disabled:no-underline disabled:text-text-muted disabled:cursor-not-allowed cursor-pointer"
            >
              {{ products[0].stock <= 0 ? '已售完' : '加入購物袋' }}
            </button>
          </div>
          <p class="font-display text-xl lg:text-[26px] text-text-primary shrink-0">NT${{ products[0].price.toLocaleString() }}</p>
        </div>
      </div>

      <!-- 2x2 grid -->
      <div class="grid grid-cols-2 gap-7">
        <div
          v-for="product in products.slice(1, 5)"
          :key="product.id"
          class="cursor-pointer group flex flex-col"
          @click="goToProduct(product.id)"
        >
          <div class="overflow-hidden h-[150px] sm:h-[200px] lg:h-[240px]">
            <img
              :src="product.image_url || fallbackImage"
              :alt="product.name"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="flex flex-col gap-1.5 pt-4">
            <p class="font-caption text-[10px] tracking-[0.3em] text-rose-primary">FLORISTE</p>
            <h3 class="font-serif-tc text-base lg:text-lg text-text-primary truncate">{{ product.name }}</h3>
            <div class="flex items-center justify-between">
              <p class="font-display text-base lg:text-[17px] text-text-primary">NT${{ product.price.toLocaleString() }}</p>
              <button
                @click.stop="addToCart(product)"
                :disabled="product._adding || product.stock <= 0"
                class="text-xs tracking-[0.15em] text-text-secondary underline underline-offset-4 hover:text-rose-primary transition-colors disabled:no-underline disabled:text-text-muted disabled:cursor-not-allowed cursor-pointer"
              >
                {{ product.stock <= 0 ? '已售完' : '加入購物袋' }}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Ornament Divider -->
  <div class="flex items-center justify-center gap-5 pb-4">
    <span class="w-28 h-px bg-hairline"></span>
    <span class="font-display text-[22px] text-rose-primary">&#10048;</span>
    <span class="w-28 h-px bg-hairline"></span>
  </div>

  <!-- Brand Story -->
  <section id="story" class="grid lg:grid-cols-2">
    <div class="flex flex-col justify-center gap-6 px-6 lg:px-24 py-16 lg:py-24 order-2 lg:order-1">
      <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-primary">№ 02 — OUR ATELIER</p>
      <h2 class="font-serif-tc text-3xl lg:text-[40px] leading-snug text-text-primary">一束花，<br>一段被記住的時光</h2>
      <p class="text-sm font-light leading-loose text-text-secondary max-w-md">
        我們的花藝師每日清晨走訪花市，只挑選當日最飽滿的花材。每一束花皆為手工製作，從修剪、配色到包裝，沒有兩束完全相同。
      </p>
      <a href="/shop" class="flex items-center gap-3 text-[13px] font-medium tracking-[0.25em] text-text-primary hover:text-rose-primary transition-colors group">
        認識我們的花藝
        <span class="w-12 h-px bg-rose-primary"></span>
      </a>
    </div>
    <div class="h-72 lg:h-[560px] order-1 lg:order-2">
      <img
        src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=1200&q=80"
        alt="花藝師工作室"
        class="w-full h-full object-cover"
      />
    </div>
  </section>

  <!-- Subscription Slab -->
  <section id="subscribe" class="bg-forest">
    <div class="grid lg:grid-cols-[620fr_820fr]">
      <div class="h-72 lg:h-full lg:min-h-[480px]">
        <img
          src="https://images.unsplash.com/photo-1759420319818-1a2c8684a584?w=1200&q=80"
          alt="訂閱花禮"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col justify-center gap-6 px-6 lg:px-24 py-16 lg:py-[35px]">
        <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-light">№ 03 — FLOWER SUBSCRIPTION</p>
        <h2 class="font-serif-tc text-3xl lg:text-[38px] leading-snug text-cream">訂閱花禮，<br>讓日常持續綻放</h2>
        <p class="text-sm font-light leading-loose text-[#A9B0A0] max-w-[400px]">
          每週或隔週配送當季花束到府。首月訂閱享 85 折，並附贈手工花器一只。
        </p>
        <div class="grid grid-cols-3 max-w-[420px] border-y border-[#3A4536] py-5">
          <div class="flex flex-col items-center gap-1">
            <span class="font-display text-xl text-cream">NT$899</span>
            <span class="text-[11px] tracking-[0.2em] text-[#A9B0A0]">每週起</span>
          </div>
          <div class="flex flex-col items-center gap-1">
            <span class="font-display text-xl text-cream">免運</span>
            <span class="text-[11px] tracking-[0.2em] text-[#A9B0A0]">全台配送</span>
          </div>
          <div class="flex flex-col items-center gap-1">
            <span class="font-display text-xl text-cream">隨時</span>
            <span class="text-[11px] tracking-[0.2em] text-[#A9B0A0]">可暫停</span>
          </div>
        </div>
        <a href="/shop" class="self-start bg-rose-primary text-white text-sm font-medium tracking-[0.3em] px-10 py-[15px] rounded hover:bg-rose-dark transition-colors">
          開始訂閱
        </a>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="bg-blush">
    <div class="max-w-3xl mx-auto flex flex-col items-center gap-7 px-6 py-20 lg:py-[110px] text-center">
      <span class="font-display text-6xl leading-none text-rose-primary">&ldquo;</span>
      <p class="font-serif-tc font-light text-xl lg:text-[28px] leading-relaxed text-text-primary">
        收到花的那一刻，我才明白<br>原來有人把我的喜悅放在心上這麼久。
      </p>
      <div class="flex flex-col items-center gap-2 pt-3">
        <span class="w-8 h-px bg-rose-primary"></span>
        <span class="font-caption text-xs tracking-[0.35em] text-text-secondary">林宛真 — 生日花束顧客</span>
      </div>
    </div>
  </section>
</div>
