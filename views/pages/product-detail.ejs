<div id="app" data-product-id="<%= productId %>">
  <div v-if="loading" class="flex justify-center py-24">
    <div class="w-8 h-8 border-2 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="notFound" class="text-center py-24">
    <p class="font-display text-3xl text-rose-primary mb-4">&#10048;</p>
    <h2 class="font-serif-tc text-xl text-text-primary mb-3">找不到此商品</h2>
    <a href="/shop" class="text-[13px] tracking-[0.2em] text-text-secondary underline underline-offset-4 hover:text-rose-primary transition-colors">回到花卉商城</a>
  </div>

  <template v-else-if="product">
    <!-- Breadcrumb -->
    <nav class="max-w-[1440px] mx-auto flex items-center gap-3 px-6 lg:px-16 py-7 text-xs tracking-[0.15em] text-text-secondary">
      <a href="/" class="hover:text-rose-primary transition-colors">首頁</a>
      <span class="text-text-muted font-caption">&mdash;</span>
      <a href="/shop" class="hover:text-rose-primary transition-colors">花卉商城</a>
      <span class="text-text-muted font-caption">&mdash;</span>
      <span class="text-text-primary truncate max-w-[200px]">{{ product.name }}</span>
    </nav>

    <!-- Main -->
    <section class="max-w-[1440px] mx-auto grid lg:grid-cols-[7fr_5fr] gap-10 lg:gap-16 px-6 lg:px-16 pb-16">
      <!-- Gallery -->
      <div class="relative overflow-hidden h-[400px] lg:h-[620px]">
        <img
          :src="product.image_url || fallbackImage"
          :alt="product.name"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Detail Panel -->
      <div class="flex flex-col">
        <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-primary mb-3.5">FLORISTE — 花藝精選</p>
        <h1 class="font-serif-tc text-3xl lg:text-[34px] leading-snug text-text-primary mb-3.5">{{ product.name }}</h1>

        <div class="flex items-center gap-5 mb-7">
          <p class="font-display text-3xl lg:text-[32px] text-text-primary">NT${{ product.price.toLocaleString() }}</p>
          <span v-if="product.stock > 0" class="flex items-center gap-2 border border-forest rounded-full px-4 py-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-sage"></span>
            <span class="text-xs tracking-[0.1em] text-text-primary">尚有 {{ product.stock }} 件</span>
          </span>
          <span v-else class="flex items-center gap-2 border border-text-muted rounded-full px-4 py-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-text-muted"></span>
            <span class="text-xs tracking-[0.1em] text-text-secondary">已售完</span>
          </span>
        </div>

        <div class="h-px bg-hairline mb-7"></div>

        <p class="text-sm font-light leading-loose text-text-secondary mb-8">{{ product.description }}</p>

        <!-- Qty + Add -->
        <div class="flex items-stretch gap-4 mb-9">
          <div class="flex items-center border border-forest">
            <button
              @click="decrease"
              :disabled="quantity <= 1"
              class="w-12 h-[52px] flex items-center justify-center font-caption text-lg transition-colors cursor-pointer"
              :class="quantity <= 1 ? 'text-text-muted cursor-not-allowed' : 'text-text-primary hover:bg-blush'"
            >
              &minus;
            </button>
            <span class="w-14 h-[52px] flex items-center justify-center font-display text-[17px] text-text-primary border-x border-hairline">
              {{ quantity }}
            </span>
            <button
              @click="increase"
              :disabled="product && quantity >= product.stock"
              class="w-12 h-[52px] flex items-center justify-center font-caption text-lg transition-colors cursor-pointer"
              :class="product && quantity >= product.stock ? 'text-text-muted cursor-not-allowed' : 'text-text-primary hover:bg-blush'"
            >
              +
            </button>
          </div>
          <button
            @click="addToCart"
            :disabled="adding || product.stock <= 0"
            class="flex-1 bg-rose-primary text-white text-sm font-medium tracking-[0.3em] rounded hover:bg-rose-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
          >
            {{ product.stock <= 0 ? '已售完' : '加入購物袋' }}
          </button>
        </div>

        <!-- Purchase Notes -->
        <div class="bg-blush p-7 flex flex-col gap-3.5">
          <p class="font-caption text-[11px] font-medium tracking-[0.3em] text-text-primary">購買須知 — BEFORE YOU ORDER</p>
          <div class="flex items-start gap-2.5">
            <span class="font-display text-[13px] text-rose-primary leading-relaxed">&#10048;</span>
            <p class="text-[13px] font-light leading-relaxed text-text-secondary">花材依季節微調，整體色系與風格不變</p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="font-display text-[13px] text-rose-primary leading-relaxed">&#10048;</span>
            <p class="text-[13px] font-light leading-relaxed text-text-secondary">台北市區當日 14:00 前下單可當日送達</p>
          </div>
          <div class="flex items-start gap-2.5">
            <span class="font-display text-[13px] text-rose-primary leading-relaxed">&#10048;</span>
            <p class="text-[13px] font-light leading-relaxed text-text-secondary">滿 NT$500 享全台免運費</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Related -->
    <template v-if="related.length > 0">
      <div class="flex items-center justify-center gap-5 pb-2">
        <span class="w-28 h-px bg-hairline"></span>
        <span class="font-display text-xl text-rose-primary">&#10048;</span>
        <span class="w-28 h-px bg-hairline"></span>
      </div>

      <section class="max-w-[1440px] mx-auto px-6 lg:px-16 pt-8 pb-20">
        <div class="flex flex-col items-center gap-2.5 mb-10">
          <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-primary">YOU MAY ALSO LIKE</p>
          <h2 class="font-serif-tc text-2xl lg:text-3xl text-text-primary">你可能也喜歡</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-7">
          <div
            v-for="p in related"
            :key="p.id"
            class="cursor-pointer group flex flex-col"
            @click="goToProduct(p.id)"
          >
            <div class="overflow-hidden h-[240px] lg:h-[280px]">
              <img
                :src="p.image_url || fallbackImage"
                :alt="p.name"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="flex flex-col gap-1.5 pt-4">
              <p class="font-caption text-[10px] tracking-[0.3em] text-rose-primary">FLORISTE</p>
              <h3 class="font-serif-tc text-lg text-text-primary truncate">{{ p.name }}</h3>
              <p class="font-display text-base text-text-primary">NT${{ p.price.toLocaleString() }}</p>
            </div>
          </div>
        </div>
      </section>
    </template>
  </template>
</div>
