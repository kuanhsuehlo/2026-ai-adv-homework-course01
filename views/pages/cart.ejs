<div id="app">
  <!-- Head -->
  <section class="flex flex-col items-center gap-3 px-6 pt-14 pb-2 text-center">
    <p class="font-caption text-[11px] font-medium tracking-[0.45em] text-rose-primary">
      YOUR BAG{{ items.length > 0 ? ' — ' + items.length + ' ITEMS' : '' }}
    </p>
    <h1 class="font-serif-tc text-4xl lg:text-[44px] text-text-primary">購物袋</h1>
  </section>

  <div v-if="loading" class="flex justify-center py-20">
    <div class="w-8 h-8 border-2 border-rose-primary border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else-if="items.length === 0" class="text-center pt-12 pb-24">
    <p class="font-display text-3xl text-rose-primary mb-4">&#10048;</p>
    <p class="text-text-secondary mb-1.5">購物袋是空的</p>
    <p class="text-text-muted text-sm mb-7">快去挑選喜歡的花束吧</p>
    <a href="/shop" class="inline-block bg-rose-primary text-white text-sm font-medium tracking-[0.3em] px-10 py-3.5 rounded hover:bg-rose-dark transition-colors">去逛逛</a>
  </div>

  <template v-else>
    <!-- Free shipping banner -->
    <section class="flex flex-col items-center gap-3 px-6 py-5">
      <p v-if="total < 500" class="text-[13px] tracking-[0.1em] text-text-primary">
        再買 NT$ {{ (500 - total).toLocaleString() }} 即可享免運費 &#10048;
      </p>
      <p v-else class="text-[13px] tracking-[0.1em] text-sage">
        &#10003; 已達免運門檻，本筆訂單免運費
      </p>
      <div class="w-full max-w-md h-[3px] bg-hairline">
        <div
          class="h-full transition-all duration-500"
          :class="total >= 500 ? 'bg-sage' : 'bg-rose-primary'"
          :style="{ width: Math.min(total / 500 * 100, 100) + '%' }"
        ></div>
      </div>
    </section>

    <!-- Main -->
    <section class="max-w-[1440px] mx-auto grid lg:grid-cols-[1fr_420px] gap-10 lg:gap-14 items-start px-6 lg:px-16 pt-6 pb-20">
      <!-- Items column -->
      <div class="flex flex-col">
        <div class="hidden sm:flex items-center gap-6 pb-3.5 border-b border-forest">
          <span class="flex-1 font-caption text-[11px] tracking-[0.25em] text-text-secondary">PRODUCT</span>
          <span class="w-[120px] text-center font-caption text-[11px] tracking-[0.25em] text-text-secondary">QTY</span>
          <span class="w-[110px] text-right font-caption text-[11px] tracking-[0.25em] text-text-secondary">SUBTOTAL</span>
        </div>

        <div
          v-for="item in items"
          :key="item.id"
          class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 py-6 border-b border-hairline"
        >
          <div class="flex items-center gap-5 flex-1 min-w-0">
            <img
              :src="item.product.image_url || 'https://images.unsplash.com/photo-1457089328109-e5d9bd499191?w=200'"
              :alt="item.product.name"
              class="w-24 h-24 object-cover flex-shrink-0"
            />
            <div class="flex flex-col gap-1.5 min-w-0">
              <p class="font-caption text-[10px] tracking-[0.3em] text-rose-primary">FLORISTE</p>
              <h3 class="font-serif-tc text-[17px] text-text-primary truncate">{{ item.product.name }}</h3>
              <div class="flex items-center gap-4">
                <span class="text-xs font-light text-text-secondary">單價 NT$ {{ item.product.price.toLocaleString() }}</span>
                <button
                  @click="confirmDelete(item.id)"
                  class="text-xs font-light text-text-secondary underline underline-offset-4 hover:text-rose-primary transition-colors cursor-pointer"
                >
                  移除
                </button>
              </div>
            </div>
          </div>

          <div class="w-[120px] flex justify-start sm:justify-center">
            <div class="flex items-center border border-[#D8CCBC]">
              <button
                @click="updateQuantity(item.id, item.quantity - 1)"
                :disabled="item.quantity <= 1"
                class="w-[34px] h-9 flex items-center justify-center font-caption text-[15px] transition-colors cursor-pointer"
                :class="item.quantity <= 1 ? 'text-[#D8CCBC] cursor-not-allowed' : 'text-text-primary hover:bg-blush'"
              >
                &minus;
              </button>
              <span class="w-10 h-9 flex items-center justify-center font-display text-sm text-text-primary border-x border-hairline">
                {{ item.quantity }}
              </span>
              <button
                @click="updateQuantity(item.id, item.quantity + 1)"
                :disabled="item.quantity >= item.product.stock"
                class="w-[34px] h-9 flex items-center justify-center font-caption text-[15px] transition-colors cursor-pointer"
                :class="item.quantity >= item.product.stock ? 'text-[#D8CCBC] cursor-not-allowed' : 'text-text-primary hover:bg-blush'"
              >
                +
              </button>
            </div>
          </div>

          <p class="w-[110px] font-display text-[17px] text-text-primary text-left sm:text-right">
            NT${{ (item.product.price * item.quantity).toLocaleString() }}
          </p>
        </div>

        <a href="/shop" class="flex items-center gap-2.5 pt-6 text-[13px] tracking-[0.15em] text-text-secondary hover:text-rose-primary transition-colors">
          <span class="font-caption">&larr;</span>
          <span class="underline underline-offset-4">繼續選購</span>
        </a>
      </div>

      <!-- Summary sidebar -->
      <div class="bg-blush p-8 flex flex-col">
        <p class="font-caption text-[11px] font-medium tracking-[0.3em] text-text-primary mb-6">ORDER SUMMARY — 訂單摘要</p>

        <div class="flex items-center justify-between py-2.5">
          <span class="text-[13px] font-light text-text-secondary">商品小計</span>
          <span class="text-[13px] text-text-primary">NT$ {{ total.toLocaleString() }}</span>
        </div>
        <div class="flex items-center justify-between py-2.5">
          <span class="text-[13px] font-light text-text-secondary">運費</span>
          <span class="text-[13px]" :class="total >= 500 ? 'text-sage' : 'text-text-primary'">
            {{ total >= 500 ? '免運' : 'NT$ 150' }}
          </span>
        </div>

        <div class="h-px bg-[#D8CCBC] my-4"></div>

        <div class="flex items-center justify-between mb-7">
          <span class="text-sm font-medium text-text-primary">總計</span>
          <span class="font-display text-[26px] text-text-primary">
            NT${{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}
          </span>
        </div>

        <button
          @click="goCheckout"
          class="w-full h-[54px] bg-rose-primary text-white text-sm font-medium tracking-[0.3em] rounded hover:bg-rose-dark transition-colors cursor-pointer"
        >
          前往結帳
        </button>

        <div class="flex items-center justify-center gap-2 pt-5">
          <span class="font-display text-[13px] text-rose-primary">&#10048;</span>
          <span class="text-xs font-light tracking-[0.1em] text-text-secondary">當日鮮採花材・安心付款保障</span>
        </div>
      </div>
    </section>
  </template>

  <!-- Confirm Dialog -->
  <div v-if="confirmVisible" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" @click="confirmVisible = false"></div>
    <div class="relative bg-cream w-full max-w-sm mx-4 p-8 text-center border-t-2 border-rose-primary">
      <p class="font-display text-xl text-rose-primary mb-3">&#10048;</p>
      <h3 class="font-serif-tc text-lg text-text-primary mb-2">確認移除</h3>
      <p class="text-text-secondary text-sm font-light mb-7">確定要從購物袋中移除這個商品嗎？</p>
      <div class="flex gap-3 justify-center">
        <button
          @click="confirmVisible = false"
          class="px-6 py-2.5 text-sm tracking-[0.15em] rounded border border-hairline text-text-secondary hover:bg-blush transition-colors cursor-pointer"
        >
          取消
        </button>
        <button
          @click="handleDelete"
          class="px-6 py-2.5 text-sm tracking-[0.15em] rounded bg-forest text-cream hover:bg-rose-dark transition-colors cursor-pointer"
        >
          確認移除
        </button>
      </div>
    </div>
  </div>
</div>
