<div id="app">
  <div class="grid grid-cols-1 lg:grid-cols-12">

    <!-- Hero panel -->
    <div class="hidden lg:block lg:col-span-5 relative overflow-hidden bg-forest min-h-[720px]">
      <img
        src="https://images.unsplash.com/photo-1508610048659-a06b669e3321?w=1200&q=80"
        alt="季節花藝"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(32,40,30,0.20) 0%, rgba(16,21,12,0.92) 100%);"></div>

      <!-- Wordmark -->
      <div class="absolute top-14 left-14">
        <p class="font-display text-cream text-2xl tracking-[0.32em]">FLORISTE</p>
        <p class="text-rose-light text-[9px] tracking-[0.5em] mt-1">花 開 有 時</p>
      </div>

      <!-- Editorial quote -->
      <div class="absolute bottom-14 left-14 right-14">
        <p class="font-caption text-rose-light text-[11px] font-medium tracking-[0.4em] mb-6">
          {{ activeTab === 'login' ? 'MEMBER ACCESS — 會員專屬' : 'NEW MEMBER — 加入會員' }}
        </p>
        <h2 class="font-serif-tc text-cream text-4xl leading-[1.45]">
          <template v-if="activeTab === 'login'">為每一次相聚，<br>備妥當季的盛開。</template>
          <template v-else>讓季節的芬芳，<br>成為生活的儀式。</template>
        </h2>
        <div class="flex items-center gap-3.5 mt-7">
          <span class="w-10 h-px bg-rose-primary"></span>
          <span class="font-caption text-text-muted text-[11px] tracking-[0.25em]">EST. 2026 · TAIPEI</span>
        </div>
      </div>
    </div>

    <!-- Form panel -->
    <div class="lg:col-span-7 bg-cream flex items-center justify-center px-6 sm:px-10 lg:px-24 py-16 lg:py-20 min-h-[600px]">
      <div class="w-full max-w-md">

        <!-- Heading -->
        <p class="font-caption text-rose-primary text-[11px] font-medium tracking-[0.4em]">
          {{ activeTab === 'login' ? 'WELCOME BACK' : 'JOIN FLORISTE' }}
        </p>
        <h1 class="font-serif-tc text-text-primary text-4xl mt-4">
          {{ activeTab === 'login' ? '歡迎回來' : '建立帳號' }}
        </h1>
        <p class="text-text-secondary text-sm leading-relaxed mt-3">
          {{ activeTab === 'login' ? '登入以管理您的訂單、收藏與花禮訂閱。' : '加入會員，享有專屬花禮訂閱與訂單追蹤。' }}
        </p>

        <!-- Tabs -->
        <div class="flex gap-9 border-b border-hairline mt-10">
          <button
            type="button"
            @click="activeTab = 'login'; errors = {}"
            class="pb-3.5 -mb-px text-[15px] tracking-[0.15em] border-b-2 transition-colors"
            :class="activeTab === 'login' ? 'text-text-primary border-rose-primary' : 'text-text-muted border-transparent hover:text-text-secondary'"
          >登入</button>
          <button
            type="button"
            @click="activeTab = 'register'; errors = {}"
            class="pb-3.5 -mb-px text-[15px] tracking-[0.15em] border-b-2 transition-colors"
            :class="activeTab === 'register' ? 'text-text-primary border-rose-primary' : 'text-text-muted border-transparent hover:text-text-secondary'"
          >註冊</button>
        </div>

        <!-- Login form -->
        <form v-if="activeTab === 'login'" @submit.prevent="handleLogin" class="mt-10">
          <div class="space-y-8">
            <div>
              <div class="border-b border-text-primary/70 focus-within:border-rose-primary transition-colors" :class="{ '!border-red-400': errors.email }">
                <label class="block font-caption text-text-secondary text-[11px] font-medium tracking-[0.25em]">EMAIL</label>
                <input
                  v-model="loginForm.email"
                  type="email"
                  placeholder="your@email.com"
                  class="w-full bg-transparent pt-2.5 pb-3.5 text-base text-text-primary placeholder:text-text-muted focus:outline-none"
                />
              </div>
              <p v-if="errors.email" class="text-red-500 text-xs mt-1.5">{{ errors.email }}</p>
            </div>

            <div>
              <div class="border-b border-text-primary/70 focus-within:border-rose-primary transition-colors" :class="{ '!border-red-400': errors.password }">
                <label class="block font-caption text-text-secondary text-[11px] font-medium tracking-[0.25em]">PASSWORD</label>
                <div class="flex items-center">
                  <input
                    v-model="loginForm.password"
                    :type="showPassword ? 'text' : 'password'"
                    placeholder="請輸入密碼"
                    class="w-full bg-transparent pt-2.5 pb-3.5 text-base text-text-primary placeholder:text-text-muted focus:outline-none"
                  />
                  <button type="button" @click="showPassword = !showPassword" class="shrink-0 text-text-muted hover:text-text-secondary transition-colors pl-3" :aria-label="showPassword ? '隱藏密碼' : '顯示密碼'">
                    <svg v-if="!showPassword" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg v-else width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </div>
              <p v-if="errors.password" class="text-red-500 text-xs mt-1.5">{{ errors.password }}</p>
            </div>
          </div>

          <div class="flex justify-end mt-4">
            <span class="text-text-secondary text-[13px] underline underline-offset-4 decoration-hairline">忘記密碼？</span>
          </div>

          <button
            type="submit"
            :disabled="submitting"
            class="group w-full flex items-center justify-center gap-3 bg-rose-primary hover:bg-rose-dark text-cream rounded-[4px] py-4 mt-8 text-[15px] tracking-[0.3em] transition-colors disabled:opacity-50"
          >
            {{ submitting ? '處理中…' : '登 入' }}
            <svg class="transition-transform group-hover:translate-x-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>

          <p class="text-center text-sm text-text-secondary mt-7">
            還沒有帳號？
            <button type="button" @click="activeTab = 'register'; errors = {}" class="text-rose-primary tracking-[0.05em] underline underline-offset-4 decoration-rose-light hover:text-rose-dark transition-colors">立即註冊</button>
          </p>
        </form>

        <!-- Register form -->
        <form v-else @submit.prevent="handleRegister" class="mt-10">
          <div class="space-y-8">
            <div>
              <div class="border-b border-text-primary/70 focus-within:border-rose-primary transition-colors" :class="{ '!border-red-400': errors.name }">
                <label class="block font-caption text-text-secondary text-[11px] font-medium tracking-[0.25em]">NAME — 姓名</label>
                <input
                  v-model="registerForm.name"
                  type="text"
                  placeholder="請輸入您的姓名"
                  class="w-full bg-transparent pt-2.5 pb-3.5 text-base text-text-primary placeholder:text-text-muted focus:outline-none"
                />
              </div>
              <p v-if="errors.name" class="text-red-500 text-xs mt-1.5">{{ errors.name }}</p>
            </div>

            <div>
              <div class="border-b border-text-primary/70 focus-within:border-rose-primary transition-colors" :class="{ '!border-red-400': errors.email }">
                <label class="block font-caption text-text-secondary text-[11px] font-medium tracking-[0.25em]">EMAIL</label>
                <input
                  v-model="registerForm.email"
                  type="email"
                  placeholder="your@email.com"
                  class="w-full bg-transparent pt-2.5 pb-3.5 text-base text-text-primary placeholder:text-text-muted focus:outline-none"
                />
              </div>
              <p v-if="errors.email" class="text-red-500 text-xs mt-1.5">{{ errors.email }}</p>
            </div>

            <div>
              <div class="border-b border-text-primary/70 focus-within:border-rose-primary transition-colors" :class="{ '!border-red-400': errors.password }">
                <label class="block font-caption text-text-secondary text-[11px] font-medium tracking-[0.25em]">PASSWORD</label>
                <div class="flex items-center">
                  <input
                    v-model="registerForm.password"
                    :type="showPassword ? 'text' : 'password'"
                    placeholder="至少 6 個字元"
                    class="w-full bg-transparent pt-2.5 pb-3.5 text-base text-text-primary placeholder:text-text-muted focus:outline-none"
                  />
                  <button type="button" @click="showPassword = !showPassword" class="shrink-0 text-text-muted hover:text-text-secondary transition-colors pl-3" :aria-label="showPassword ? '隱藏密碼' : '顯示密碼'">
                    <svg v-if="!showPassword" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg v-else width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </div>
              <p v-if="errors.password" class="text-red-500 text-xs mt-1.5">{{ errors.password }}</p>
            </div>
          </div>

          <button
            type="submit"
            :disabled="submitting"
            class="group w-full flex items-center justify-center gap-3 bg-rose-primary hover:bg-rose-dark text-cream rounded-[4px] py-4 mt-9 text-[15px] tracking-[0.3em] transition-colors disabled:opacity-50"
          >
            {{ submitting ? '處理中…' : '註 冊' }}
            <svg class="transition-transform group-hover:translate-x-1" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>

          <p class="text-center text-sm text-text-secondary mt-7">
            已經有帳號了？
            <button type="button" @click="activeTab = 'login'; errors = {}" class="text-rose-primary tracking-[0.05em] underline underline-offset-4 decoration-rose-light hover:text-rose-dark transition-colors">前往登入</button>
          </p>
        </form>

      </div>
    </div>

  </div>
</div>
